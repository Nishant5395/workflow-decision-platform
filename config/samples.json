        "claim": { "claimId": "CLM-1003", "policyNumber": "POL-1003", "type": "property", "amount": 80000, "incidentDate": "2026-08-20", "reportedDate": "2026-08-25" },
        "claimant": { "id": "C-79", "name": "Sunita Rao" },
        "documents": ["invoice", "photos"]
      }
    },
    {
      "name": "Lapsed policy → rejected",
      "description": "Coverage rules fail: policy inactive, nothing covered, limit exceeded.",
      "expect": "REJECTED",
      "payload": {
        "claim": { "claimId": "CLM-1004", "policyNumber": "POL-LAPSED-9", "type": "auto", "amount": 12000, "incidentDate": "2026-07-01", "reportedDate": "2026-07-03" },
        "claimant": { "id": "C-80", "name": "Dev Malhotra" },
        "documents": ["invoice"]
      }
    },
    {
      "name": "Late reporting → manual review",
      "description": "Reported 65 days after the incident; flagged at intake.",
      "expect": "MANUAL_REVIEW",
      "payload": {
        "claim": { "claimId": "CLM-1005", "policyNumber": "POL-1005", "type": "auto", "amount": 9000, "incidentDate": "2026-08-01", "reportedDate": "2026-10-05" },
        "claimant": { "id": "C-81", "name": "Isha Kapoor" },
        "documents": ["invoice"]
      }
    },
    {
      "name": "Missing invoice → rejected",
      "description": "Mandatory document missing; rejected at intake with no external call.",
      "expect": "REJECTED",
      "payload": {
        "claim": { "claimId": "CLM-1006", "policyNumber": "POL-1006", "type": "auto", "amount": 4000, "incidentDate": "2026-10-01", "reportedDate": "2026-10-02" },
        "claimant": { "id": "C-82", "name": "Manish Pillai" },
        "documents": ["photos"]
      }
    }
  ],
